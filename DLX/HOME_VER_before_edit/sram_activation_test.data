00000000 // 0x3C: res_sig_pos2  sigmoid(+2.0) --> exp 0x0000E000
00000000 // 0x3D: res_sig_zero  sigmoid( 0.0) --> exp 0x00008000
00000000 // 0x3E: res_sig_neg2  sigmoid(-2.0) --> exp 0x00002000
