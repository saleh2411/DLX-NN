// ============================================================================
//          DLX SOFTMAX DMA TEST - sram_softmax_test.data
// ============================================================================
// Tests the SOFTMAX instruction end-to-end:
//   - decode (opcode 111101), operand read (rs1=input base, rs2=output base)
//   - vec_len field instr[10:0]
//   - DMA pass 1 (max + denominator) and pass 2 (normalize + write back)
//   - mem_arbiter bus handover (DLX stalls, DMA owns bus, DLX resumes)
//   - CPU resumes after softmax_done (pass marker written AFTER softmax)
//
// SOFTMAX encoding (R-type):
//   [31:26]=111101  [25:21]=rs1  [20:16]=rs2  [15:11]=0  [10:0]=vec_len
//   softmax R1, R2, len=4  ->  111101 00001 00010 00000 00000000100 = F4220004
//
// !! NOTE 1 (DMA stride): softmax_dma is byte-addressed (addr = base + 4*idx)
//    but this DLX memory is WORD-addressed. So vector elements live 4 words
//    apart: inputs at 0x60,0x64,0x68,0x6C ; outputs at 0x80,0x84,0x88,0x8C.
//    Gap words hold DEADBEEF sentinels - they must never be read as inputs
//    nor overwritten by the DMA.
//
// !! NOTE 2 (halt): halt is the canonical FC000000 (opcode 111111). Softmax
//    moved to opcode 111101, so 111111 no longer matches D10_SOFTMAX and
//    falls through to the default branch -> S_HALT, as intended.
//
// Input vector (Q16.16):  x = [1.0, 2.0, 3.0, 4.0]
//
// Expected outputs (from py/Softmax/softmax_golden.py -x 1 2 3 4):
//   0x80 = 0x00000736   y0 ~ 0.0282
//   0x84 = 0x00001716   y1 ~ 0.0902
//   0x88 = 0x000039B7   y2 ~ 0.2254
//   0x8C = 0x0000B8B0   y3 ~ 0.7214
//   (sum ~ 1.065 - approximation error of shift-exp/PWL, matches golden)
//
// PASS MARKER:
//   0x50 = 0x600D600D   written AFTER softmax completes (proves handshake)
//
// Register readback (visible in waveform via GPR):
//   R10 = y0, R11 = y1, R12 = y2, R13 = y3, R29 = 0x600D600D
// ============================================================================

// ============================================================================
//                         CODE SECTION (starts at 0x00)
// ============================================================================
20010060 // 0x00: addi R1, R0, 0x60   ; R1 = input vector base
20020080 // 0x01: addi R2, R0, 0x80   ; R2 = output vector base
F4220004 // 0x02: softmax R1, R2, 4   ; softmax over x[0..3], results -> [R2]
8C0A0080 // 0x03: lw R10, R0, 0x80    ; R10 = y0  exp: 0x00000736
8C0B0084 // 0x04: lw R11, R0, 0x84    ; R11 = y1  exp: 0x00001716
8C0C0088 // 0x05: lw R12, R0, 0x88    ; R12 = y2  exp: 0x000039B7
8C0D008C // 0x06: lw R13, R0, 0x8C    ; R13 = y3  exp: 0x0000B8B0
8C1D0058 // 0x07: lw R29, R0, 0x58    ; R29 = 0x600D600D
AC1D0050 // 0x08: sw R29, R0, 0x50    ; M[0x50] = pass marker
FC000000 // 0x09: halt                ; opcode 111111 (see NOTE 2)

// ============================================================================
//                         PADDING (0x0A - 0x4F)
// ============================================================================
