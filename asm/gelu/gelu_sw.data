// ============================================================================
// GELU - PURE SOFTWARE (baseline)
// ============================================================================
// Source     : asm/gelu/gelu_sw.s   (assembled listing asm/gelu/gelu_sw.lst)
// Format     : flat $readmemh image - one 32-bit word per line, bare hex,
//              consecutive WORD addresses starting at 0x00. // comments OK.
// Numbers    : Q16.16 signed fixed point  (real r  <->  round(r * 65536)).
//
// >>>>>>>>>>>>>>>>>>>>>>  OUTPUT ADDRESS(ES)  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
//   0x05   result
// >>>>>>>>>>>>>>>>>>>>>>  INPUT  ADDRESS(ES)  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
//   0x04 = 00018000   input
//
// Path       : SOFTWARE only (no activation opcode used)
// Pairs with : gelu_hw.data
// Both files run the SAME math on the SAME input - the only difference is
// who does the work, so the cycle counts are directly comparable.
//
// Math       : gelu(x) = x * sigmoid(k*x), k = 1.70703125 built shift-add as
//   x + x>>1 + x>>3 + x>>4 + x>>6 + x>>8, then one Q16.16 multiply.
//   HW: sigmoid_subenv.v x_gelu/y_gelu.  SW: asm/gelu/gelu_sw.s (same shifts, mult instr).
//
// Program image is 90 words (0x00 .. 0x59). Halt = FFFF****.
// ============================================================================

2C010012 // 0x00: start: addi R1 R0 main * R1 = address of main
583F726F // 0x01: jr R1 * jump to main
C3FF206E // 0x02: special-nop
C3FF4020 // 0x03: special-nop
00018000 // 0x04: input: dc 0x18000 * x = 1.5 in Q16.16 (1.5*65536). EDIT ME.
00000000 // 0x05: result: dc 0x0
00010000 // 0x06: cONE: dc 0x10000 * +1.0
00050000 // 0x07: cX5: dc 0x50000 * 5.0 segment threshold
00026000 // 0x08: cX2375: dc 0x26000 * 2.375 segment threshold
00012000 // 0x09: cX1125: dc 0x12000 * 1.125 segment threshold
0000E000 // 0x0A: cX0875: dc 0xe000 * 0.875 segment threshold
0000D800 // 0x0B: cB2732: dc 0xd800 * 0.84375 intercept (27/32)
0000A000 // 0x0C: cB58: dc 0xa000 * 0.625 intercept (5/8)
00009B27 // 0x0D: cBTAY: dc 0x9b27 * 0.6060586 intercept (Taylor repair @ z=1)
00008000 // 0x0E: cB12: dc 0x8000 * 0.5 intercept (1/2)
00000800 // 0x0F: cS32: dc 0x800 * 1/32 slope (Q16.16) for mult
00002000 // 0x10: cS8: dc 0x2000 * 1/8 slope (Q16.16) for mult
00004000 // 0x11: cS4: dc 0x4000 * 1/4 slope (Q16.16) for mult
8C090004 // 0x12: main: lw R9 R0 input * R9 = x_q (kept for the final product)
01202023 // 0x13: add R4 R9 R0 * R4 = x
70880000 // 0x14: slti R8 R4 0x0000 * R8 = 1 if x < 0
111F0001 // 0x15: beqz R8 gabs * x >= 0 -> R4 already |x|
00042022 // 0x16: sub R4 R0 R4 * R4 = -x = |x|
00800823 // 0x17: gabs: add R1 R4 R0 * R1 = ax
009F2802 // 0x18: srli R5 R4 * ax>>1
00250823 // 0x19: add R1 R1 R5 * + ax>>1
00BF2802 // 0x1A: srli R5 R5 * ax>>2
00BF2802 // 0x1B: srli R5 R5 * ax>>3
00250823 // 0x1C: add R1 R1 R5 * + ax>>3
00BF2802 // 0x1D: srli R5 R5 * ax>>4
00250823 // 0x1E: add R1 R1 R5 * + ax>>4
00BF2802 // 0x1F: srli R5 R5 * ax>>5
00BF2802 // 0x20: srli R5 R5 * ax>>6
00250823 // 0x21: add R1 R1 R5 * + ax>>6
00BF2802 // 0x22: srli R5 R5 * ax>>7
00BF2802 // 0x23: srli R5 R5 * ax>>8
00250823 // 0x24: add R1 R1 R5 * + ax>>8 => R1 = kax = 1.707*|x|
111F0001 // 0x25: beqz R8 gsig
00010822 // 0x26: sub R1 R0 R1 * kx = -kax
2C07002C // 0x27: gsig: addi R7 R0 sigsub * R7 = address of sigmoid subroutine
5CFF0000 // 0x28: jalr R7 * R2 = sigma(kx), R31 = return
F9221000 // 0x29: dc 0xF9221000 * mult: R2 = R9 * R2
AC020005 // 0x2A: sw R2 R0 result * result = y_q
FFFF6375 // 0x2B: halt
2C030000 // 0x2C: sigsub: addi R3 R0 0x0000 * sign = 0
70250000 // 0x2D: slti R5 R1 0x0000 * R5 = 1 if z < 0
10BF0002 // 0x2E: beqz R5 sigpos * z >= 0 -> no mirror
00010822 // 0x2F: sub R1 R0 R1 * z = -z (now z >= 0)
2C030001 // 0x30: addi R3 R0 0x0001 * sign = 1
8C060007 // 0x31: sigpos: lw R6 R0 cX5 * R6 = 5.0
00262822 // 0x32: sub R5 R1 R6 * R5 = z - 5.0
70A50000 // 0x33: slti R5 R5 0x0000 * R5 = 1 if z < 5.0
14BF0002 // 0x34: bnez R5 sigseg2 * z < 5.0 -> next segment
8C020006 // 0x35: lw R2 R0 cONE * y = 1.0
101F001F // 0x36: beqz R0 sigsign * apply sign, return
8C060008 // 0x37: sigseg2: lw R6 R0 cX2375 * R6 = 2.375
00262822 // 0x38: sub R5 R1 R6
70A50000 // 0x39: slti R5 R5 0x0000 * R5 = 1 if z < 2.375
14BF0005 // 0x3A: bnez R5 sigseg3
8C06000F // 0x3B: lw R6 R0 cS32 * R6 = 1/32
F8261000 // 0x3C: dc 0xF8261000 * mult: R2 = R1 * R6 = z>>5
8C06000B // 0x3D: lw R6 R0 cB2732 * R6 = 0.84375
00461023 // 0x3E: add R2 R2 R6 * y = (z>>5) + 0.84375
101F0016 // 0x3F: beqz R0 sigsign
8C060009 // 0x40: sigseg3: lw R6 R0 cX1125 * R6 = 1.125
00262822 // 0x41: sub R5 R1 R6
70A50000 // 0x42: slti R5 R5 0x0000 * R5 = 1 if z < 1.125
14BF0005 // 0x43: bnez R5 sigseg4
8C060010 // 0x44: lw R6 R0 cS8 * R6 = 1/8
F8261000 // 0x45: dc 0xF8261000 * mult: R2 = R1 * R6 = z>>3
8C06000C // 0x46: lw R6 R0 cB58 * R6 = 0.625
00461023 // 0x47: add R2 R2 R6 * y = (z>>3) + 0.625
101F000D // 0x48: beqz R0 sigsign
8C06000A // 0x49: sigseg4: lw R6 R0 cX0875 * R6 = 0.875
00262822 // 0x4A: sub R5 R1 R6
70A50000 // 0x4B: slti R5 R5 0x0000 * R5 = 1 if z < 0.875
14BF0005 // 0x4C: bnez R5 sigseg5
8C060010 // 0x4D: lw R6 R0 cS8 * R6 = 1/8
F8261000 // 0x4E: dc 0xF8261000 * mult: R2 = R1 * R6 = z>>3
8C06000D // 0x4F: lw R6 R0 cBTAY * R6 = 0.6060586 (Taylor repair @ z=1)
00461023 // 0x50: add R2 R2 R6 * y = (z>>3) + 0.6060586
101F0004 // 0x51: beqz R0 sigsign
8C060011 // 0x52: sigseg5: lw R6 R0 cS4 * R6 = 1/4
F8261000 // 0x53: dc 0xF8261000 * mult: R2 = R1 * R6 = z>>2
8C06000E // 0x54: lw R6 R0 cB12 * R6 = 0.5
00461023 // 0x55: add R2 R2 R6 * y = (z>>2) + 0.5
107F0002 // 0x56: sigsign: beqz R3 sigret * sign == 0 -> done
8C060006 // 0x57: lw R6 R0 cONE * R6 = 1.0
00C21022 // 0x58: sub R2 R6 R2 * y = 1.0 - y
5BFF0000 // 0x59: sigret: jr R31 * return to caller
