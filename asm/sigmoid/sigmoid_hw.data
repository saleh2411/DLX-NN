// ============================================================================
// SIGMOID - HARDWARE ACCELERATED
// ============================================================================
// Source     : asm/sigmoid/sigmoid_hw.s   (assembled listing asm/sigmoid/sigmoid_hw.lst)
// Format     : flat $readmemh image - one 32-bit word per line, bare hex,
//              consecutive WORD addresses starting at 0x00. // comments OK.
// Numbers    : Q16.16 signed fixed point  (real r  <->  round(r * 65536)).
//
// >>>>>>>>>>>>>>>>>>>>>>  OUTPUT ADDRESS(ES)  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
//   0x05   result
// >>>>>>>>>>>>>>>>>>>>>>  INPUT  ADDRESS(ES)  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
//   0x04 = 00028000   input
//
// Path       : HARDWARE activation instruction
// Pairs with : sigmoid_sw.data
// Both files run the SAME math on the SAME input - the only difference is
// who does the work, so the cycle counts are directly comparable.
//
// Math       : 5-segment PWL sigmoid, thresholds {5.0, 2.375, 1.125, 0.875},
//   intercepts {1.0, 0.84375, 0.625, 0.6060586, 0.5}, slopes 1/32,1/8,1/8,1/4.
//   Identical tables in HW (design/sigmoid/sigmoid.v) and SW (asm/sigmoid/sigmoid_sw.s).
//
// Program image is 10 words (0x00 .. 0x09). Halt = FFFF****.
// ============================================================================

2C010006 // 0x00: start: addi R1 R0 main * R1 = address of main
583F3631 // 0x01: jr R1 * jump to main
C3FF3631 // 0x02: special-nop
C3FF003A // 0x03: special-nop
00028000 // 0x04: input: dc 0x28000 * x = 2.5 in Q16.16 (2.5*65536). EDIT ME.
00000000 // 0x05: result: dc 0x0
8C010004 // 0x06: main: lw R1 R0 input * R1 = x_q (Q16.16 input)
E0220000 // 0x07: sigmoid R2 R1 0x0 * R2 = sigmoid(R1) <-- HW activation unit
AC020005 // 0x08: sw R2 R0 result * result = y_q (Q16.16 output)
FFFF6E6F // 0x09: halt
